@page "/EditarEtiquetas"
@inject mnts.Services.GastosService GastosService

<div class="mobile-container editaretiquetas-container">

    <!-- TOPBAR MOBILE -->
    <header class="mobile-topbar">
        <NavLink href="/" class="mobile-back-button" aria-label="Volver">
            ‹
        </NavLink>
        <h1 class="mobile-topbar-title">Editar Categorías</h1>
        <div class="mobile-topbar-spacer"></div>
    </header>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="mobile-toast @(esError ? "mobile-toast-error" : "mobile-toast-success")">
            @mensaje
        </div>
    }

    <main class="editaretiquetas-content">

        <div class="etiquetas-cabecera">
            <span class="cabecera-icon">🎨</span>
            <div class="cabecera-textos">
                <span class="cabecera-titulo">Personalizá tus categorías</span>
                <span class="cabecera-sub">Elegí el emoji y el nombre representativo para cada gasto</span>
            </div>
        </div>

        <div class="lista-editor-etiquetas">
            @foreach (var etiqueta in etiquetas)
            {
                <div class="card-editor-etiqueta">
                    <div class="selector-icono-box">
                        <select class="select-emoji" @bind="etiqueta.Icono">
                            @foreach (var opcion in OpcionesIconos)
                            {
                                <option value="@opcion">@opcion</option>
                            }
                        </select>
                    </div>

                    <div class="input-nombre-box">
                        <input type="text"
                               class="mobile-input input-nombre-etiqueta"
                               placeholder="Nombre de categoría"
                               maxlength="20"
                               @bind="etiqueta.Nombre"
                               @bind:event="oninput" />
                    </div>
                </div>
            }
        </div>

        <div class="card-restaurar">
            <div class="restaurar-info">
                <span class="restaurar-titulo">¿Querés volver al inicio?</span>
                <span class="restaurar-sub">Podés restablecer los nombres e íconos originales de fábrica</span>
            </div>
            <button class="mobile-btn mobile-btn-secondary btn-restaurar" @onclick="RestaurarValoresDefecto">
                Restaurar por defecto
            </button>
        </div>

    </main>

    <!-- BARRA STICKY INFERIOR -->
    <footer class="mobile-sticky-bottom">
        <button class="mobile-btn mobile-btn-primary" @onclick="GuardarCambios">
            <span>💾 Guardar Cambios</span>
        </button>
    </footer>

</div>

@code {

    private List<mnts.Models.Etiqueta> etiquetas = new();
    private string? mensaje;
    private bool esError = false;

    private static readonly string[] OpcionesIconos =
    {
        "🍔", "🏠", "💡", "🎮", "❤️", "📦",
        "🚍", "🎓", "💊", "🐾", "🎁", "☕",
        "🛒", "✈️", "🎬", "💰", "🔧", "📱"
    };

    protected override async Task OnInitializedAsync()
    {
        etiquetas = await GastosService.ObtenerEtiquetasAsync();
    }

    private async Task GuardarCambios()
    {
        foreach (var etiqueta in etiquetas)
        {
            if (string.IsNullOrWhiteSpace(etiqueta.Nombre))
            {
                mensaje = "Ningún nombre de categoría puede quedar vacío";
                esError = true;
                return;
            }
        }

        foreach (var etiqueta in etiquetas)
        {
            await GastosService.ActualizarEtiquetaAsync(etiqueta.Id, etiqueta.Nombre.Trim(), etiqueta.Icono);
        }

        mensaje = "¡Categorías actualizadas correctamente!";
        esError = false;
        await MostrarMensajeTemporal();
    }

    private async Task RestaurarValoresDefecto()
    {
        await GastosService.RestaurarEtiquetasAsync();
        etiquetas = await GastosService.ObtenerEtiquetasAsync();
        mensaje = "Categorías restauradas a valores por defecto";
        esError = false;
        await MostrarMensajeTemporal();
    }

    private async Task MostrarMensajeTemporal()
    {
        StateHasChanged();
        await Task.Delay(2000);
        mensaje = null;
        StateHasChanged();
    }

}
