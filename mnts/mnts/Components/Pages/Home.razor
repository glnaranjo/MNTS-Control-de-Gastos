@page "/"
@inject mnts.Services.GastosService GastosService

<div class="mobile-container home-container">

    <div class="home-main">

        <!-- LOGO Y TÍTULO MNTS -->
        <div class="home-header">
            @if (!mostrarOpciones)
            {
                <img src="./images/logo.png" class="home-logo" alt="MNTS Logo" />
            }

            <p class="home-texto-logo">
                @(mostrarOpciones ? "Opciones" : "Control de gastos")
            </p>
        </div>

        @if (!mostrarOpciones)
        {
            <!-- BOTONES PRINCIPALES MODERNOS -->
            <div class="contenedor-botones">

                <NavLink href="/Gastos" class="boton-mnts">
                    <span class="btn-icono">💸</span>
                    <span class="btn-texto">Ingresar gastos</span>
                </NavLink>

                <NavLink href="/Resumen" class="boton-mnts">
                    <span class="btn-icono">📊</span>
                    <span class="btn-texto">Ver resumen mensual</span>
                </NavLink>

                <NavLink href="/Ingresos" class="boton-mnts">
                    <span class="btn-icono">💰</span>
                    <span class="btn-texto">Añadir ingresos</span>
                </NavLink>

                <button class="boton-mnts" @onclick="() => mostrarOpciones = true">
                    <span class="btn-icono">⚙️</span>
                    <span class="btn-texto">Opciones</span>
                </button>

                <button class="boton-mnts boton-salir" @onclick="CerrarApp">
                    <span class="btn-icono">🚪</span>
                    <span class="btn-texto">Salir</span>
                </button>

            </div>
        }
        else
        {
            <!-- SUBSECCIONES DE OPCIONES (MODERNAS) -->
            <div class="contenedor-botones">

                <NavLink href="/BorrarGastos" class="boton-mnts">
                    <span class="btn-icono">🗑️</span>
                    <span class="btn-texto">Borrar gastos</span>
                </NavLink>

                <NavLink href="/BorrarPresupuesto" class="boton-mnts">
                    <span class="btn-icono">💵</span>
                    <span class="btn-texto">Borrar presupuesto/ingresos</span>
                </NavLink>

                <NavLink href="/EditarEtiquetas" class="boton-mnts">
                    <span class="btn-icono">🏷️</span>
                    <span class="btn-texto">Editar categorías</span>
                </NavLink>

                <button class="boton-mnts" @onclick="AbrirManualDeUso">
                    <span class="btn-icono">📖</span>
                    <span class="btn-texto">Manual de uso</span>
                </button>

                <NavLink href="/SobreNosotros" class="boton-mnts">
                    <span class="btn-icono">ℹ️</span>
                    <span class="btn-texto">Sobre nosotros</span>
                </NavLink>

                <button class="boton-mnts boton-peligro" @onclick="AbrirModalReinicio">
                    <span class="btn-icono">⚠️</span>
                    <span class="btn-texto">Reiniciar Datos</span>
                </button>

                <button class="boton-mnts boton-volver" @onclick="() => mostrarOpciones = false">
                    <span class="btn-icono">↩️</span>
                    <span class="btn-texto">Volver</span>
                </button>

                @if (!string.IsNullOrEmpty(errorManual))
                {
                    <div class="mobile-toast mobile-toast-error">
                        @errorManual
                    </div>
                }

            </div>
        }

    </div>

</div>

@if (mostrarModalReinicio)
{
    <div class="modal-backdrop" @onclick="CerrarModalReinicio">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h3 class="modal-titulo">¿Estás seguro?</h3>

            <p class="modal-desc">
                Esta acción eliminará <strong>TODOS</strong> los gastos e ingresos registrados, y restablecerá los nombres de las etiquetas a sus valores por defecto. Esta acción <strong>NO se puede deshacer</strong>.
            </p>

            <div class="modal-input-group">
                <label class="modal-input-label">
                    Para confirmar, escribí:<br />
                    <code>Deseo eliminar todos mis datos</code>
                </label>
                <input type="text"
                       class="mobile-input modal-input-field"
                       placeholder="Deseo eliminar todos mis datos"
                       @bind="textoConfirmacion"
                       autocomplete="off"
                       autocorrect="off"
                       autocapitalize="off" />
            </div>

            @if (!string.IsNullOrEmpty(mensajeModal))
            {
                <p class="modal-error">@mensajeModal</p>
            }

            <div class="modal-acciones">
                <button class="boton-mnts boton-peligro" @onclick="ConfirmarReinicio">
                    Confirmar Reinicio
                </button>
                <button class="boton-mnts boton-volver" @onclick="CerrarModalReinicio">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
}

@code {

    bool mostrarOpciones = false;
    bool mostrarModalReinicio = false;
    string? textoConfirmacion;
    string? mensajeModal;

    const string FraseConfirmacion = "Deseo eliminar todos mis datos";

    void CerrarApp()
    {
        Application.Current?.Quit();
    }

    void AbrirModalReinicio()
    {
        mostrarModalReinicio = true;
        textoConfirmacion = null;
        mensajeModal = null;
    }

    void CerrarModalReinicio()
    {
        mostrarModalReinicio = false;
        textoConfirmacion = null;
        mensajeModal = null;
    }

    async Task ConfirmarReinicio()
    {
        if (textoConfirmacion != FraseConfirmacion)
        {
            mensajeModal = "El texto no coincide, intentá de nuevo";
            return;
        }

        await GastosService.ReiniciarBaseDatosAsync();

        mensajeModal = null;
        mostrarModalReinicio = false;
        mostrarOpciones = false;
    }

    private string? errorManual;

    private async Task AbrirManualDeUso()
    {
        errorManual = null;
        try
        {
            var nombreArchivo = "Manual de uso.pdf";
            var rutaDestino = Path.Combine(FileSystem.CacheDirectory, nombreArchivo);

            if (!File.Exists(rutaDestino) || new FileInfo(rutaDestino).Length == 0)
            {
                Stream? streamOrigen = null;
                try
                {
                    // En Android es case-sensitive (el archivo físico en Resources/Raw es 'Manual de uso.pdf')
                    streamOrigen = await FileSystem.OpenAppPackageFileAsync("Manual de uso.pdf");
                }
                catch
                {
                    // Fallback
                    streamOrigen = await FileSystem.OpenAppPackageFileAsync("Manual De Uso.pdf");
                }

                using (streamOrigen)
                using (var streamDestino = File.Create(rutaDestino))
                {
                    await streamOrigen.CopyToAsync(streamDestino);
                }
            }

            // Intentamos abrir con Launcher y si no con Share para máxima compatibilidad
            var abrio = await Launcher.Default.OpenAsync(new OpenFileRequest
            {
                Title = "Manual de uso MNTS",
                File = new ReadOnlyFile(rutaDestino)
            });

            if (!abrio)
            {
                await Share.Default.RequestAsync(new ShareFileRequest
                {
                    Title = "Abrir Manual de uso",
                    File = new ShareFile(rutaDestino)
                });
            }
        }
        catch (Exception ex)
        {
            try
            {
                var ruta = Path.Combine(FileSystem.CacheDirectory, "Manual de uso.pdf");
                if (File.Exists(ruta))
                {
                    await Share.Default.RequestAsync(new ShareFileRequest
                    {
                        Title = "Abrir Manual de uso",
                        File = new ShareFile(ruta)
                    });
                    return;
                }
            }
            catch { }

            errorManual = $"Error al abrir manual: {ex.Message}";
        }
    }

}
