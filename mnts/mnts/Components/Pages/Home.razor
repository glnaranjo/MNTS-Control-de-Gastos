@page "/"

<div class="contenedor-main">

    <div class="menu-imagenDeco">
        <img src="./images/fondo.png" />
    </div>

    <div class="menu-inicio">

        <div>
            <img src="./images/logo.png" class="logoPrinc" />

            <p class="textoLogo">
                Control de gastos
            </p>
        </div>

        <div class="contenedor-botones">

            <NavLink href="/Gastos" class="botones">
                Ingresar gastos
            </NavLink>

            <NavLink href="/Resumen" class="botones">
                Ver resumen mensual
            </NavLink>

            <NavLink href="/Ingresos" class="botones">
                Añadir ingresos
            </NavLink>

            <NavLink href="/Opciones" class="botones">
                Opciones
            </NavLink>

            <button class="botones" @onclick="CerrarApp" style="background-color: #f22c2c">
                Salir
            </button>

        </div>

    </div>
</div>



@code {

    void CerrarApp()
    {
        Application.Current?.Quit();
    }

}