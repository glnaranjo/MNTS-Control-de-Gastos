@page "/BorrarPresupuesto"
@inject mnts.Services.GastosService GastosService

<div class="ContenedorGastosMain">

    <NavLink href="/" class="BotonVolver">
        ← Volver
    </NavLink>

    <div class="ContenedorCentro">

        <div class="Header">
            <h2 class="Titulo">Borrar Presupuesto/Ingreso</h2>
        </div>

        @if (estado == EstadoPantalla.Formulario)
        {
            <div class="Seccion">
                <center><p class="subtitulo">Ingrese la fecha</p></center>

                <div class="CamposFecha">
                    <div class="CampoFecha">
                        <label class="LabelCampo">Mes</label>
                        <input type="number" min="1" max="12" placeholder="MM" class="InputCampo" @bind="mes" />
                    </div>

                    <span class="SeparadorFecha">/</span>

                    <div class="CampoFecha">
                        <label class="LabelCampo">Año</label>
                        <input type="number" placeholder="AAAA" class="InputCampo" @bind="anio" />
                    </div>
                </div>
            </div>

            <div class="ContenedorBotones">
                <button class="botones Guardar" @onclick="BuscarIngresos">
                    Buscar
                </button>
            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <p class="subtitulo2 MensajeError">@mensajeError</p>
            }
        }
        else
        {
            @if (ingresosListado.Count == 0)
            {
                <p class="subtitulo2">No hay presupuesto registrado para ese mes</p>
            }
            else
            {
                <div class="ListaRegistros">
                    @foreach (var ingreso in ingresosListado)
                    {
                        <div class="FilaRegistro">

                            @if (editandoId == ingreso.Id)
                            {
                                <div class="EdicionFila">
                                    <input type="text" class="InputEdicion" @bind="montoEdicion" placeholder="Monto" />

                                    <button class="botones Guardar BotonChico" @onclick="() => GuardarEdicion(ingreso.Id)">
                                        Guardar
                                    </button>

                                    <button class="botones botonVolver BotonChico" @onclick="CancelarEdicion">
                                        Cancelar
                                    </button>
                                </div>
                            }
                            else if (eliminandoId == ingreso.Id)
                            {
                                <div class="ConfirmarFila">
                                    <span class="TextoConfirmar">¿Eliminar este ingreso?</span>

                                    <button class="botones Borrar BotonChico" @onclick="() => ConfirmarEliminar(ingreso.Id)">
                                        Sí
                                    </button>

                                    <button class="botones botonVolver BotonChico" @onclick="() => eliminandoId = null">
                                        No
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="DatoFila MontoFila">$@ingreso.Monto.ToString("N2")</span>

                                <div class="AccionesFila">
                                    <button class="botones Guardar BotonChico" @onclick="() => IniciarEdicion(ingreso)">
                                        Editar
                                    </button>

                                    <button class="botones Borrar BotonChico" @onclick="() => eliminandoId = ingreso.Id">
                                        Eliminar
                                    </button>
                                </div>
                            }

                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(mensajeAccion))
            {
                <p class="subtitulo2 MensajeExito">@mensajeAccion</p>
            }

            <div class="ContenedorBotones">
                <button class="botones botonVolver" @onclick="VolverAlFormulario">
                    Buscar otro mes
                </button>
            </div>
        }

    </div>

</div>

@code {

    private enum EstadoPantalla { Formulario, Listado }

    private EstadoPantalla estado = EstadoPantalla.Formulario;

    private int? mes;
    private int? anio;

    private string? mensajeError;
    private string? mensajeAccion;

    private List<mnts.Models.Ingreso> ingresosListado = new();

    private int? editandoId;
    private string? montoEdicion;

    private int? eliminandoId;

    private async Task BuscarIngresos()
    {
        mensajeError = null;

        if (mes is null || mes < 1 || mes > 12)
        {
            mensajeError = "Error, ingrese un mes válido (1-12)";
            return;
        }

        if (anio is null || anio < 2000)
        {
            mensajeError = "Error, ingrese un año válido";
            return;
        }

        ingresosListado = await GastosService.ObtenerIngresosPorFechaAsync(mes.Value, anio.Value);
        estado = EstadoPantalla.Listado;
    }

    private void IniciarEdicion(mnts.Models.Ingreso ingreso)
    {
        editandoId = ingreso.Id;
        montoEdicion = ingreso.Monto.ToString("0.##");
        eliminandoId = null;
    }

    private void CancelarEdicion()
    {
        editandoId = null;
        montoEdicion = null;
    }

    private async Task GuardarEdicion(int id)
    {
        if (string.IsNullOrWhiteSpace(montoEdicion) || !double.TryParse(montoEdicion, out var monto))
        {
            mensajeAccion = "Error, ingresá un monto válido";
            return;
        }

        await GastosService.ActualizarIngresoAsync(id, monto);

        editandoId = null;
        ingresosListado = await GastosService.ObtenerIngresosPorFechaAsync(mes!.Value, anio!.Value);

        mensajeAccion = "Ingreso actualizado correctamente";
        await MostrarMensajeTemporal();
    }

    private async Task ConfirmarEliminar(int id)
    {
        await GastosService.BorrarIngresoPorIdAsync(id);

        eliminandoId = null;
        ingresosListado = await GastosService.ObtenerIngresosPorFechaAsync(mes!.Value, anio!.Value);

        mensajeAccion = "Ingreso eliminado correctamente";
        await MostrarMensajeTemporal();
    }

    private async Task MostrarMensajeTemporal()
    {
        StateHasChanged();
        await Task.Delay(1500);
        mensajeAccion = null;
        StateHasChanged();
    }

    private void VolverAlFormulario()
    {
        estado = EstadoPantalla.Formulario;
        ingresosListado.Clear();
        mes = null;
        anio = null;
        editandoId = null;
        eliminandoId = null;
        mensajeError = null;
        mensajeAccion = null;
    }

}