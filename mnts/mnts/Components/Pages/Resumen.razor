@page "/Resumen"
@inject mnts.Services.GastosService GastosService
@using ApexCharts
@inject mnts.Services.ExportService ExportService

<div class="mobile-container resumen-container">

    <!-- TOPBAR MOBILE -->
    <header class="mobile-topbar">
        <NavLink href="/" class="mobile-back-button" aria-label="Volver">
            ‹
        </NavLink>
        <h1 class="mobile-topbar-title">Resumen Mensual</h1>
        <div class="mobile-topbar-spacer"></div>
    </header>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="mobile-toast mobile-toast-error">
            @mensajeError
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExportacion))
    {
        <div class="mobile-toast mobile-toast-success">
            @mensajeExportacion
        </div>
    }

    <main class="resumen-content">

        <!-- SELECTOR DE PERÍODO -->
        <section class="card-filtro-periodo">
            <div class="periodo-header">
                <span class="periodo-icon">🗓️</span>
                <span class="periodo-titulo">Período de consulta</span>
            </div>

            <div class="periodo-selectores">
                <div class="selector-mes-wrapper">
                    <label class="selector-label">Mes</label>
                    <select class="mobile-input select-mes" @bind="mes">
                        <option value="1">Enero</option>
                        <option value="2">Febrero</option>
                        <option value="3">Marzo</option>
                        <option value="4">Abril</option>
                        <option value="5">Mayo</option>
                        <option value="6">Junio</option>
                        <option value="7">Julio</option>
                        <option value="8">Agosto</option>
                        <option value="9">Septiembre</option>
                        <option value="10">Octubre</option>
                        <option value="11">Noviembre</option>
                        <option value="12">Diciembre</option>
                    </select>
                </div>

                <div class="selector-anio-wrapper">
                    <label class="selector-label">Año</label>
                    <input type="number"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           placeholder="AAAA"
                           class="mobile-input input-anio"
                           @bind="anio" />
                </div>

                <div class="selector-btn-wrapper">
                    <button class="mobile-btn mobile-btn-primary btn-consultar" @onclick="VerResumen">
                        <span>🔍 Ver</span>
                    </button>
                </div>
            </div>
        </section>

        @if (mostrarResumen)
        {
            @if (!hayDatos)
            {
                <div class="card-vacio">
                    <span class="vacio-icon">📭</span>
                    <p class="vacio-titulo">Sin movimientos registrados</p>
                    <p class="vacio-sub">No encontramos gastos ni ingresos para este mes.</p>
                </div>
            }
            else
            {
                <!-- MÉTRICAS PRINCIPALES EN TARJETAS MOBILE -->
                <section class="tarjetas-metricas">
                    <div class="tarjeta-metrica metrica-gastos">
                        <span class="metrica-label">Gasto Total</span>
                        <span class="metrica-monto text-danger">-$@totalGastos.ToString("N2")</span>
                    </div>

                    <div class="tarjeta-metrica metrica-ingresos">
                        <span class="metrica-label">Ingreso Total</span>
                        <span class="metrica-monto text-success">+$@totalIngresos.ToString("N2")</span>
                    </div>

                    <div class="tarjeta-metrica metrica-balance">
                        <span class="metrica-label">Balance</span>
                        <span class="metrica-monto @claseDiferencia">
                            @(diferencia >= 0 ? "+" : "-")$@Math.Abs(diferencia).ToString("N2")
                        </span>
                    </div>
                </section>

                <!-- GRÁFICO DE DISTRIBUCIÓN -->
                <section class="card-reporte">
                    <div class="reporte-header">
                        <span class="reporte-icon">🍩</span>
                        <h2 class="reporte-titulo">Distribución de Gastos</h2>
                    </div>

                    @if (categorias.Count > 0)
                    {
                        <div class="chart-wrapper">
                            <ApexChart TItem="mnts.Models.ResumenCategoria"
                                       Height="260">
                                <ApexPointSeries TItem="mnts.Models.ResumenCategoria"
                                                 Items="categorias"
                                                 Name="Gastos"
                                                 SeriesType="SeriesType.Donut"
                                                 XValue="e => e.Categoria"
                                                 YValue="e => (decimal)e.Total" />
                            </ApexChart>
                        </div>

                        <!-- LISTA DE CATEGORÍAS CON BARRA DE PROGRESO -->
                        <div class="lista-categorias-detalle">
                            @foreach (var item in categorias)
                            {
                                var porcentaje = totalGastos > 0 ? (item.Total / totalGastos) * 100 : 0;

                                <div class="item-categoria-fila">
                                    <div class="item-categoria-cabecera">
                                        <span class="item-categoria-nombre">@item.Categoria</span>
                                        <div class="item-categoria-valores">
                                            <span class="item-categoria-monto">$@item.Total.ToString("N2")</span>
                                            <span class="item-categoria-pct">@porcentaje.ToString("N1")%</span>
                                        </div>
                                    </div>
                                    <div class="progreso-barra-bg">
                                        <div class="progreso-barra-fill" style="width: @Math.Min(100, Math.Max(2, (int)porcentaje))%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="seccion-hint text-center">No hay gastos en este mes para graficar</p>
                    }
                </section>

                <!-- EVOLUCIÓN HISTÓRICA -->
                <section class="card-reporte">
                    <div class="reporte-header">
                        <span class="reporte-icon">📈</span>
                        <h2 class="reporte-titulo">Evolución de Gastos</h2>
                    </div>
                    <p class="reporte-subtitulo">Comportamiento en los últimos 6 meses</p>

                    <div class="chart-wrapper">
                        <ApexChart TItem="PuntoHistorial"
                                   Height="220">
                            <ApexPointSeries TItem="PuntoHistorial"
                                             Items="historialGrafico"
                                             Name="Gasto mensual"
                                             SeriesType="SeriesType.Line"
                                             XValue="e => e.Etiqueta"
                                             YValue="e => (decimal)e.Total"
                                             ShowDataLabels="false" />
                        </ApexChart>
                    </div>

                    <!-- ESTADÍSTICAS DESTACADAS -->
                    <div class="stats-destacadas">
                        @if (diaMayor is not null)
                        {
                            <div class="stat-pill stat-pill-danger">
                                <span class="stat-pill-icon">🔥</span>
                                <div class="stat-pill-info">
                                    <span class="stat-pill-title">Día de mayor gasto</span>
                                    <span class="stat-pill-value">Día @diaMayor ($@montoDiaMayor.ToString("N2"))</span>
                                </div>
                            </div>
                        }

                        @if (diaMenor is not null)
                        {
                            <div class="stat-pill stat-pill-success">
                                <span class="stat-pill-icon">🌱</span>
                                <div class="stat-pill-info">
                                    <span class="stat-pill-title">Día de menor gasto</span>
                                    <span class="stat-pill-value">Día @diaMenor ($@montoDiaMenor.ToString("N2"))</span>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(textoComparacion))
                        {
                            <div class="stat-pill stat-pill-info">
                                <span class="stat-pill-icon">⚖️</span>
                                <div class="stat-pill-info">
                                    <span class="stat-pill-title">Comparativa mes anterior</span>
                                    <span class="stat-pill-value @claseComparacion">@textoComparacion</span>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                <!-- BOTONES DE ACCIÓN -->
                <section class="acciones-resumen">
                    <button class="mobile-btn mobile-btn-primary btn-exportar" @onclick="ExportarAExcel">
                        <span>📊 Exportar a Excel</span>
                    </button>
                </section>
            }
        }

    </main>

</div>

@code {

    private int? mes = DateTime.Today.Month;
    private int? anio = DateTime.Today.Year;
    private string? mensajeError;
    private bool mostrarResumen = false;
    private bool hayDatos = false;

    private List<mnts.Models.ResumenCategoria> categorias = new();
    private double totalGastos;
    private double totalIngresos;
    private double diferencia;
    private string claseDiferencia = "";

    private int? diaMayor;
    private double montoDiaMayor;
    private int? diaMenor;
    private double montoDiaMenor;
    private string textoComparacion = "";
    private string claseComparacion = "";

    private static readonly string[] NombresMeses =
    { "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" };

    private class PuntoHistorial
    {
        public string Etiqueta { get; set; } = "";
        public double Total { get; set; }
    }

    private List<PuntoHistorial> historialGrafico = new();

    protected override async Task OnInitializedAsync()
    {
        // Carga automática del mes en curso al entrar
        await VerResumen();
    }

    private async Task VerResumen()
    {
        mensajeError = null;
        mensajeExportacion = null;
        mostrarResumen = false;

        if (mes is null || mes < 1 || mes > 12)
        {
            mensajeError = "Por favor seleccioná un mes válido (1-12)";
            return;
        }

        if (anio is null || anio < 2000)
        {
            mensajeError = "Por favor ingresá un año válido";
            return;
        }

        categorias = await GastosService.ObtenerResumenPorCategoriaAsync(mes.Value, anio.Value);
        totalGastos = await GastosService.ObtenerTotalGastosAsync(mes.Value, anio.Value);
        totalIngresos = await GastosService.ObtenerTotalIngresosAsync(mes.Value, anio.Value);

        hayDatos = categorias.Count > 0 || totalGastos > 0 || totalIngresos > 0;

        if (hayDatos)
        {
            diferencia = totalIngresos - totalGastos;
            claseDiferencia = diferencia > 0 ? "text-success" : diferencia < 0 ? "text-danger" : "";

            var (diaMax, montoMax) = await GastosService.ObtenerDiaMayorGastoAsync(mes.Value, anio.Value);
            diaMayor = diaMax;
            montoDiaMayor = montoMax;

            var (diaMin, montoMin) = await GastosService.ObtenerDiaMenorGastoAsync(mes.Value, anio.Value);
            diaMenor = diaMin;
            montoDiaMenor = montoMin;

            var mesAnterior = mes.Value == 1 ? 12 : mes.Value - 1;
            var anioAnterior = mes.Value == 1 ? anio.Value - 1 : anio.Value;
            var totalMesAnterior = await GastosService.ObtenerTotalGastosAsync(mesAnterior, anioAnterior);

            var diferenciaAnterior = totalGastos - totalMesAnterior;

            if (diferenciaAnterior > 0)
            {
                textoComparacion = $"Gastaste ${diferenciaAnterior:N2} más que el mes anterior";
                claseComparacion = "text-danger";
            }
            else if (diferenciaAnterior < 0)
            {
                textoComparacion = $"Ahorraste ${Math.Abs(diferenciaAnterior):N2} respecto al mes anterior";
                claseComparacion = "text-success";
            }
            else
            {
                textoComparacion = "Gastaste exactamente lo mismo que el mes anterior";
                claseComparacion = "";
            }

            var historial = await GastosService.ObtenerHistorialGastosAsync(mes.Value, anio.Value, 6);

            historialGrafico = historial
                .Select(h => new PuntoHistorial
                {
                    Etiqueta = $"{NombresMeses[h.Mes - 1]}",
                    Total = h.Total
                })
                .ToList();
        }

        mostrarResumen = true;
    }

    private string? mensajeExportacion;

    private async Task ExportarAExcel()
    {
        var datos = new mnts.Models.ResumenExportData
        {
            Mes = mes!.Value,
            Anio = anio!.Value,
            Categorias = categorias,
            TotalGastos = totalGastos,
            TotalIngresos = totalIngresos,
            Diferencia = diferencia,
            DiaMayor = diaMayor,
            MontoDiaMayor = montoDiaMayor,
            DiaMenor = diaMenor,
            MontoDiaMenor = montoDiaMenor
        };

        string ruta;

        try
        {
            ruta = ExportService.ExportarExcel(datos);
        }
        catch (Exception ex)
        {
            mensajeExportacion = $"Error al exportar: {ex.Message}";
            return;
        }

        mensajeExportacion = $"Excel generado exitosamente";

        await Launcher.Default.OpenAsync(new OpenFileRequest
        {
            File = new ReadOnlyFile(ruta)
        });
    }

}
