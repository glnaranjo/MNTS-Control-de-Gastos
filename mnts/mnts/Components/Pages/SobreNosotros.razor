@page "/SobreNosotros"

<div class="mobile-container sobrenosotros-container">

    <!-- TOPBAR MOBILE -->
    <header class="mobile-topbar">
        <NavLink href="/" class="mobile-back-button" aria-label="Volver">
            ‹
        </NavLink>
        <h1 class="mobile-topbar-title">Sobre Nosotros</h1>
        <div class="mobile-topbar-spacer"></div>
    </header>

    <main class="sobrenosotros-content">

        <!-- LOGOS CARD -->
        <section class="card-identidad">
            <div class="logos-fila">
                <img src="./images/logo.png" class="logo-mnts" alt="MNTS" />
                <span class="texto-by">by</span>
                <img src="./images/logo-gnand.png" class="logo-gnand" alt="G-NAND" />
            </div>

            <h2 class="app-nombre">MNTS: Control de Gastos</h2>
            <div class="version-badge">Versión 2.0 • Edición Mobile</div>
        </section>

        <!-- DESCRIPCIÓN -->
        <section class="card-info">
            <div class="info-item">
                <span class="info-icon">🇦🇷</span>
                <div class="info-texto">
                    <span class="info-titulo">Desarrollo Argentino</span>
                    <p class="info-desc">
                        MNTS es una aplicación desarrollada por la iniciativa G-NAND con el objetivo de brindar software gratuito, intuitivo y accesible para ayudar a las personas en su economía diaria.
                    </p>
                </div>
            </div>

            <div class="info-separador"></div>

            <div class="info-item">
                <span class="info-icon">🔒</span>
                <div class="info-texto">
                    <span class="info-titulo">Privacidad 100% Local</span>
                    <p class="info-desc">
                        Tus registros de gastos e ingresos se guardan únicamente de forma local en tu dispositivo. Ningún dato viaja a servidores externos ni se comparte con terceros.
                    </p>
                </div>
            </div>
        </section>

        <!-- CONTACTO -->
        <section class="card-contacto">
            <span class="contacto-titulo">¿Encontraste un error o tenés una sugerencia?</span>
            <p class="contacto-sub">Tu feedback es esencial para seguir mejorando la app</p>

            <a href="mailto:gnandcontact@gmail.com" class="mobile-btn mobile-btn-primary btn-contacto">
                <span>✉️ Contactar a Soporte</span>
            </a>
            <span class="email-texto">gnandcontact@gmail.com</span>
        </section>

    </main>

</div>
