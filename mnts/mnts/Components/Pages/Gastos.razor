@page "/Gastos"
@inject mnts.Services.GastosService GastosService

<div class="ContenedorGastosMain">

    <NavLink href="/" class="BotonVolver">
        ← Volver
    </NavLink>

    <div class="ContenedorCentro">

        <div class="Header">
            <h2 class="Titulo">Registro de Gastos</h2>
        </div>

        <div class="Seccion">
            <p class="subtitulo">Fecha</p>
            <input type="date" class="InputFecha" @bind="fecha" />
        </div>

        <div class="Seccion">
            <p class="subtitulo">Ingrese sus gastos</p>

            <div class="Etiquetas">
                @foreach (var etiqueta in etiquetas)
                {
                    <div class="CardGasto">
                        <p class="Etiqueta">@etiqueta.Icono @etiqueta.Nombre</p>
                        <input type="text" placeholder="Ej: 12000"
                               value="@ObtenerValor(etiqueta.Id)"
                               @oninput="e => ActualizarValor(etiqueta.Id, e.Value?.ToString())" />
                    </div>
                }
            </div>
        </div>

        <div class="ContenedorBotones">

            <button class="botones Guardar" @onclick="GuardarGastos">
                Guardar
            </button>

            <button class="botones Borrar" @onclick="() => LimpiarCampos()">
                Borrar
            </button>

        </div>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="subtitulo2">@mensaje</p>
        }
        else
        {
            <p class="subtitulo2">
                Las etiquetas se pueden modificar desde el menú de opciones
            </p>
        }

    </div>

</div>

@code {

    private List<mnts.Models.Etiqueta> etiquetas = new();
    private Dictionary<int, string?> valores = new();
    private DateOnly? fecha;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        etiquetas = await GastosService.ObtenerEtiquetasAsync();
    }

    private string? ObtenerValor(int id) =>
        valores.TryGetValue(id, out var valor) ? valor : null;

    private void ActualizarValor(int id, string? valor)
    {
        valores[id] = valor;
    }

    private async Task GuardarGastos()
    {
        if (fecha is null)
        {
            mensaje = "Error, seleccione una fecha válida";
            await MostrarMensajeTemporal();
            return;
        }

        var seGuardoAlgo = false;

        foreach (var etiqueta in etiquetas)
        {
            if (valores.TryGetValue(etiqueta.Id, out var valor) &&
                !string.IsNullOrWhiteSpace(valor) &&
                double.TryParse(valor, out var monto))
            {
                await GastosService.InsertarGastoAsync(fecha.Value.Day, fecha.Value.Month, fecha.Value.Year, etiqueta.Nombre, monto);
                seGuardoAlgo = true;
            }
        }

        mensaje = seGuardoAlgo
            ? "Gastos guardados correctamente"
            : "Ingrese al menos un gasto";

        if (seGuardoAlgo)
        {
            LimpiarCampos(borrarMensaje: false);
        }

        await MostrarMensajeTemporal();
    }

    private async Task MostrarMensajeTemporal()
    {
        StateHasChanged();
        await Task.Delay(1500);
        mensaje = null;
        StateHasChanged();
    }

    private void LimpiarCampos(bool borrarMensaje = true)
    {
        valores.Clear();

        if (borrarMensaje)
        {
            mensaje = null;
        }
    }

}