@page "/Gastos"
@inject mnts.Services.GastosService GastosService

<div class="mobile-container gastos-container">

    <!-- TOPBAR MOBILE -->
    <header class="mobile-topbar">
        <NavLink href="/" class="mobile-back-button" aria-label="Volver">
            ‹
        </NavLink>
        <h1 class="mobile-topbar-title">Registrar Gastos</h1>
        <div class="mobile-topbar-spacer"></div>
    </header>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="mobile-toast @(esError ? "mobile-toast-error" : "mobile-toast-success")">
            @mensaje
        </div>
    }

    <main class="gastos-content">

        <!-- FECHA -->
        <section class="card-seccion">
            <div class="seccion-header">
                <span class="seccion-icon">📅</span>
                <span class="seccion-titulo">Fecha del gasto</span>
            </div>
            <div class="input-fecha-wrapper">
                <input type="date" class="mobile-input input-fecha" @bind="fecha" />
            </div>
        </section>

        <!-- CATEGORÍAS -->
        <section class="seccion-categorias">
            <div class="seccion-header">
                <span class="seccion-icon">🏷️</span>
                <span class="seccion-titulo">Monto por categoría</span>
            </div>
            <p class="seccion-hint">Ingresá el importe en las categorías que correspondan</p>

            <div class="etiquetas-grid">
                @foreach (var etiqueta in etiquetas)
                {
                    var tieneValor = !string.IsNullOrWhiteSpace(ObtenerValor(etiqueta.Id));

                    <div class="card-gasto @(tieneValor ? "card-gasto-activo" : "")">
                        <div class="card-gasto-header">
                            <span class="card-gasto-icono">@etiqueta.Icono</span>
                            <span class="card-gasto-nombre">@etiqueta.Nombre</span>
                        </div>
                        <div class="card-gasto-input-wrapper">
                            <span class="moneda-signo">$</span>
                            <input type="text"
                                   inputmode="decimal"
                                   pattern="[0-9]*"
                                   placeholder="0"
                                   class="card-gasto-input"
                                   value="@ObtenerValor(etiqueta.Id)"
                                   @oninput="e => ActualizarValor(etiqueta.Id, e.Value?.ToString())" />
                        </div>
                    </div>
                }
            </div>
        </section>

    </main>

    <!-- BARRA FLOTANTE INFERIOR -->
    <footer class="mobile-sticky-bottom">
        <button class="mobile-btn mobile-btn-primary btn-guardar" @onclick="GuardarGastos">
            <span>💾 Guardar Gastos</span>
        </button>
        <button class="mobile-btn mobile-btn-secondary btn-limpiar" @onclick="LimpiarCampos" title="Limpiar campos">
            <span>X</span>
        </button>
    </footer>

</div>

@code {

    private List<mnts.Models.Etiqueta> etiquetas = new();
    private Dictionary<int, string?> valores = new();
    private DateOnly? fecha = DateOnly.FromDateTime(DateTime.Today);
    private string? mensaje;
    private bool esError = false;

    protected override async Task OnInitializedAsync()
    {
        etiquetas = await GastosService.ObtenerEtiquetasAsync();
    }

    private string? ObtenerValor(int id) =>
        valores.TryGetValue(id, out var valor) ? valor : null;

    private void ActualizarValor(int id, string? valor)
    {
        valores[id] = valor;
    }

    private async Task GuardarGastos()
    {
        if (fecha is null)
        {
            mensaje = "Error: seleccioná una fecha válida";
            esError = true;
            await MostrarMensajeTemporal();
            return;
        }

        var seGuardoAlgo = false;

        foreach (var etiqueta in etiquetas)
        {
            if (valores.TryGetValue(etiqueta.Id, out var valor) &&
                !string.IsNullOrWhiteSpace(valor) &&
                double.TryParse(valor.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var monto) &&
                monto > 0)
            {
                await GastosService.InsertarGastoAsync(
                    fecha.Value.Day,
                    fecha.Value.Month,
                    fecha.Value.Year,
                    etiqueta.Nombre,
                    monto
                );
                seGuardoAlgo = true;
            }
        }

        if (!seGuardoAlgo)
        {
            mensaje = "Ingresá al menos un monto para guardar";
            esError = true;
            await MostrarMensajeTemporal();
            return;
        }

        mensaje = "¡Gastos guardados correctamente!";
        esError = false;
        LimpiarCampos();

        await MostrarMensajeTemporal();
    }

    private void LimpiarCampos()
    {
        valores.Clear();
    }

    private async Task MostrarMensajeTemporal()
    {
        StateHasChanged();
        await Task.Delay(2500);
        mensaje = null;
        StateHasChanged();
    }

}
