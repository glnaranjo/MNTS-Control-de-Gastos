@page "/Gastos"

<div class="ContenedorGastosMain">

    <NavLink href="/" class="BotonVolver">
        ← Volver
    </NavLink>

    <div class="ContenedorCentro">

        <p class="subtitulo" style="margin-top: 8%;">Ingrese la fecha de los gastos</p>
        <p><input type="date" /></p>

        <br />

        <p class="subtitulo">Ingrese sus gastos</p>

        <div class="Etiquetas">

            <p class="Etiqueta">Comida <br /><input type="text" placeholder="$" /></p>
            <p class ="Etiqueta">Vivienda <br /><input type="text" placeholder="$" /></p>
            <p class ="Etiqueta">Servicios <br /><input type="text" placeholder="$" /></p>
            <p class="Etiqueta">Ocio <br /><input type="text" placeholder="$" /></p>
            <p class="Etiqueta">Salud <br /><input type="text" placeholder="$" /></p>
            <p class="Etiqueta">Extras <br /><input type="text" placeholder="$" /></p>

        </div>

        <br /><br />

        <div class="ContenedorBotones">

            <button class="botones">
                Guardar
            </button>

            <button class="botones">
                Borrar
            </button>

        </div>

        <br /><br />

        <p class="subtitulo2" >(Las etiquetas se pueden cambiar en el menu de "Opciones")</p>

    </div>

</div>
