@page "/BorrarGastos"
@inject mnts.Services.GastosService GastosService

<div class="mobile-container borrargastos-container">

    <!-- TOPBAR MOBILE -->
    <header class="mobile-topbar">
        @if (estado == EstadoPantalla.Listado)
        {
            <button class="mobile-back-button" @onclick="VolverAlFormulario" aria-label="Volver a búsqueda">
                ‹
            </button>
        }
        else
        {
            <NavLink href="/" class="mobile-back-button" aria-label="Volver">
                ‹
            </NavLink>
        }
        <h1 class="mobile-topbar-title">Gestionar Gastos</h1>
        <div class="mobile-topbar-spacer"></div>
    </header>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="mobile-toast mobile-toast-error">
            @mensajeError
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeAccion))
    {
        <div class="mobile-toast mobile-toast-success">
            @mensajeAccion
        </div>
    }

    <main class="borrargastos-content">

        @if (estado == EstadoPantalla.Formulario)
        {
            <!-- FORMULARIO DE FILTRO -->
            <section class="card-filtro">
                <div class="filtro-header">
                    <span class="filtro-icon">🔍</span>
                    <span class="filtro-titulo">Buscar gastos por fecha</span>
                </div>
                <p class="filtro-sub">Podés filtrar por mes entero o especificar un día particular</p>

                <div class="filtro-campos-grid">
                    <div class="filtro-campo">
                        <label class="filtro-label">Día (opcional)</label>
                        <input type="number"
                               min="1"
                               max="31"
                               inputmode="numeric"
                               placeholder="Todos"
                               class="mobile-input"
                               @bind="dia" />
                    </div>

                    <div class="filtro-campo">
                        <label class="filtro-label">Mes</label>
                        <select class="mobile-input" @bind="mes">
                            <option value="1">Enero</option>
                            <option value="2">Febrero</option>
                            <option value="3">Marzo</option>
                            <option value="4">Abril</option>
                            <option value="5">Mayo</option>
                            <option value="6">Junio</option>
                            <option value="7">Julio</option>
                            <option value="8">Agosto</option>
                            <option value="9">Septiembre</option>
                            <option value="10">Octubre</option>
                            <option value="11">Noviembre</option>
                            <option value="12">Diciembre</option>
                        </select>
                    </div>

                    <div class="filtro-campo">
                        <label class="filtro-label">Año</label>
                        <input type="number"
                               inputmode="numeric"
                               placeholder="AAAA"
                               class="mobile-input"
                               @bind="anio" />
                    </div>
                </div>

                <button class="mobile-btn mobile-btn-primary btn-buscar-gastos" @onclick="BuscarGastos">
                    <span>🔍 Buscar Registros</span>
                </button>
            </section>
        }
        else
        {
            <!-- LISTADO DE RESULTADOS -->
            <div class="listado-cabecera">
                <span class="listado-conteo">
                    @gastosListado.Count @(gastosListado.Count == 1 ? "gasto encontrado" : "gastos encontrados")
                </span>
                <button class="btn-cambiar-filtro" @onclick="VolverAlFormulario">
                    Filtros ▾
                </button>
            </div>

            @if (gastosListado.Count == 0)
            {
                <div class="card-vacio">
                    <span class="vacio-icon">📭</span>
                    <p class="vacio-titulo">No hay gastos para esa fecha</p>
                    <p class="vacio-sub">Probá buscando en otro día o mes.</p>
                </div>
            }
            else
            {
                <div class="lista-gastos">
                    @foreach (var gasto in gastosListado)
                    {
                        <div class="card-registro">

                            @if (editandoId == gasto.Id)
                            {
                                <!-- MODO EDICIÓN -->
                                <div class="edicion-box">
                                    <span class="edicion-titulo">✏️ Editando gasto del día @gasto.Dia</span>

                                    <div class="edicion-campos">
                                        <div class="campo-edicion-categoria">
                                            <label class="filtro-label">Categoría</label>
                                            <select class="mobile-input" @bind="categoriaEdicion">
                                                @foreach (var etiqueta in etiquetas)
                                                {
                                                    <option value="@etiqueta.Nombre">@etiqueta.Icono @etiqueta.Nombre</option>
                                                }
                                                @if (!etiquetas.Any(e => e.Nombre == gasto.Categoria))
                                                {
                                                    <option value="@gasto.Categoria">@gasto.Categoria</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="campo-edicion-monto">
                                            <label class="filtro-label">Monto ($)</label>
                                            <input type="text"
                                                   inputmode="decimal"
                                                   class="mobile-input"
                                                   @bind="montoEdicion"
                                                   placeholder="0.00" />
                                        </div>
                                    </div>

                                    <div class="edicion-acciones">
                                        <button class="mobile-btn mobile-btn-primary btn-chico" @onclick="() => GuardarEdicion(gasto.Id)">
                                            Guardar
                                        </button>
                                        <button class="mobile-btn mobile-btn-secondary btn-chico" @onclick="CancelarEdicion">
                                            Cancelar
                                        </button>
                                    </div>
                                </div>
                            }
                            else if (eliminandoId == gasto.Id)
                            {
                                <!-- MODO CONFIRMACIÓN ELIMINAR -->
                                <div class="confirmar-box">
                                    <span class="confirmar-titulo">¿Eliminar este gasto de $@gasto.Monto.ToString("N2")?</span>
                                    <div class="confirmar-acciones">
                                        <button class="mobile-btn mobile-btn-danger btn-chico" @onclick="() => ConfirmarEliminar(gasto.Id)">
                                            Sí, eliminar
                                        </button>
                                        <button class="mobile-btn mobile-btn-secondary btn-chico" @onclick="() => eliminandoId = null">
                                            Cancelar
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- VISTA NORMAL REGISTRO -->
                                <div class="registro-fila-info">
                                    <div class="registro-badge-fecha">
                                        <span class="badge-dia">Día @gasto.Dia</span>
                                        <span class="badge-mes">@gasto.Mes/@gasto.Anio</span>
                                    </div>

                                    <div class="registro-detalle">
                                        <span class="registro-categoria">@gasto.Categoria</span>
                                        <span class="registro-monto">-$@gasto.Monto.ToString("N2")</span>
                                    </div>
                                </div>

                                <div class="registro-acciones">
                                    <button class="btn-accion-icono btn-accion-editar" @onclick="() => IniciarEdicion(gasto)" title="Editar">
                                        ✏️
                                    </button>
                                    <button class="btn-accion-icono btn-accion-borrar" @onclick="() => eliminandoId = gasto.Id" title="Eliminar">
                                        🗑️
                                    </button>
                                </div>
                            }

                        </div>
                    }
                </div>
            }
        }

    </main>

</div>

@code {

    private enum EstadoPantalla { Formulario, Listado }

    private EstadoPantalla estado = EstadoPantalla.Formulario;

    private int? dia;
    private int? mes = DateTime.Today.Month;
    private int? anio = DateTime.Today.Year;

    private string? mensajeError;
    private string? mensajeAccion;

    private List<mnts.Models.Gasto> gastosListado = new();
    private List<mnts.Models.Etiqueta> etiquetas = new();

    private int? editandoId;
    private string? categoriaEdicion;
    private string? montoEdicion;

    private int? eliminandoId;

    protected override async Task OnInitializedAsync()
    {
        etiquetas = await GastosService.ObtenerEtiquetasAsync();
    }

    private async Task BuscarGastos()
    {
        mensajeError = null;

        if (mes is null || mes < 1 || mes > 12)
        {
            mensajeError = "Por favor seleccioná un mes válido (1-12)";
            return;
        }

        if (anio is null || anio < 2000)
        {
            mensajeError = "Por favor ingresá un año válido";
            return;
        }

        if (dia is not null && (dia < 1 || dia > 31))
        {
            mensajeError = "El día debe estar entre 1 y 31";
            return;
        }

        gastosListado = await GastosService.ObtenerGastosPorFechaAsync(dia, mes.Value, anio.Value);
        estado = EstadoPantalla.Listado;
    }

    private void IniciarEdicion(mnts.Models.Gasto gasto)
    {
        editandoId = gasto.Id;
        categoriaEdicion = gasto.Categoria;
        montoEdicion = gasto.Monto.ToString("0.##");
        eliminandoId = null;
    }

    private void CancelarEdicion()
    {
        editandoId = null;
        categoriaEdicion = null;
        montoEdicion = null;
    }

    private async Task GuardarEdicion(int id)
    {
        if (string.IsNullOrWhiteSpace(categoriaEdicion) ||
            string.IsNullOrWhiteSpace(montoEdicion) ||
            !double.TryParse(montoEdicion.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var monto) ||
            monto <= 0)
        {
            mensajeAccion = "Error: revisá los datos ingresados";
            return;
        }

        await GastosService.ActualizarGastoAsync(id, categoriaEdicion, monto);

        editandoId = null;
        gastosListado = await GastosService.ObtenerGastosPorFechaAsync(dia, mes!.Value, anio!.Value);

        mensajeAccion = "Gasto actualizado correctamente";
        await MostrarMensajeTemporal();
    }

    private async Task ConfirmarEliminar(int id)
    {
        await GastosService.BorrarGastoPorIdAsync(id);

        eliminandoId = null;
        gastosListado = await GastosService.ObtenerGastosPorFechaAsync(dia, mes!.Value, anio!.Value);

        mensajeAccion = "Gasto eliminado correctamente";
        await MostrarMensajeTemporal();
    }

    private async Task MostrarMensajeTemporal()
    {
        StateHasChanged();
        await Task.Delay(2000);
        mensajeAccion = null;
        StateHasChanged();
    }

    private void VolverAlFormulario()
    {
        estado = EstadoPantalla.Formulario;
        editandoId = null;
        eliminandoId = null;
        mensajeError = null;
        mensajeAccion = null;
    }

}
