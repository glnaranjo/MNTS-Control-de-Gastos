@page "/BorrarGastos"
@inject mnts.Services.GastosService GastosService

<div class="ContenedorGastosMain">

    <NavLink href="/" class="BotonVolver">
        ← Volver
    </NavLink>

    <div class="ContenedorCentro">

        <div class="Header">
            <h2 class="Titulo">Borrar Gastos</h2>
        </div>

        @if (estado == EstadoPantalla.Formulario)
        {
            <div class="Seccion">
                <center><p class="subtitulo">Ingrese la fecha</p></center>

                <div class="CamposFecha">
                    <div class="CampoFecha">
                        <label class="LabelCampo">Día</label>
                        <input type="number" min="1" max="31" placeholder="Opcional" class="InputCampo" @bind="dia" />
                    </div>

                    <span class="SeparadorFecha">/</span>

                    <div class="CampoFecha">
                        <label class="LabelCampo">Mes</label>
                        <input type="number" min="1" max="12" placeholder="MM" class="InputCampo" @bind="mes" />
                    </div>

                    <span class="SeparadorFecha">/</span>

                    <div class="CampoFecha">
                        <label class="LabelCampo">Año</label>
                        <input type="number" placeholder="AAAA" class="InputCampo" @bind="anio" />
                    </div>
                </div>
            </div>

            <div class="ContenedorBotones">
                <button class="botones Guardar" @onclick="BuscarGastos">
                    Buscar
                </button>
            </div>

            <div class="Avisos">
                <p class="subtitulo2">En caso de no seleccionar dia se mostraran todos los registros del mes</p>
            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <p class="subtitulo2 MensajeError">@mensajeError</p>
            }
        }
        else
        {
            @if (gastosListado.Count == 0)
            {
                <p class="subtitulo2">No hay gastos registrados para esa fecha</p>
            }
            else
            {
                <div class="ListaRegistros">
                    @foreach (var gasto in gastosListado)
                    {
                        <div class="FilaRegistro">

                            @if (editandoId == gasto.Id)
                            {
                                <div class="EdicionFila">
                                    <select class="SelectEdicion" @bind="categoriaEdicion">
                                        @foreach (var etiqueta in etiquetas)
                                        {
                                            <option value="@etiqueta.Nombre">@etiqueta.Nombre</option>
                                        }
                                        @if (!etiquetas.Any(e => e.Nombre == gasto.Categoria))
                                        {
                                            <option value="@gasto.Categoria">@gasto.Categoria</option>
                                        }
                                    </select>

                                    <input type="text" class="InputEdicion" @bind="montoEdicion" placeholder="Monto" />

                                    <button class="botones Guardar BotonChico" @onclick="() => GuardarEdicion(gasto.Id)">
                                        Guardar
                                    </button>

                                    <button class="botones botonVolver BotonChico" @onclick="CancelarEdicion">
                                        Cancelar
                                    </button>
                                </div>
                            }
                            else if (eliminandoId == gasto.Id)
                            {
                                <div class="ConfirmarFila">
                                    <span class="TextoConfirmar">¿Eliminar este gasto?</span>

                                    <button class="botones Borrar BotonChico" @onclick="() => ConfirmarEliminar(gasto.Id)">
                                        Sí
                                    </button>

                                    <button class="botones botonVolver BotonChico" @onclick="() => eliminandoId = null">
                                        No
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="DatoFila">Día @gasto.Dia</span>
                                <span class="DatoFila NombreCategoriaFila">@gasto.Categoria</span>
                                <span class="DatoFila MontoFila">$@gasto.Monto.ToString("N2")</span>

                                <div class="AccionesFila">
                                    <button class="botones Guardar BotonChico" @onclick="() => IniciarEdicion(gasto)">
                                        Editar
                                    </button>

                                    <button class="botones Borrar BotonChico" @onclick="() => eliminandoId = gasto.Id">
                                        Eliminar
                                    </button>
                                </div>
                            }

                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(mensajeAccion))
            {
                <p class="subtitulo2 MensajeExito">@mensajeAccion</p>
            }

            <div class="ContenedorBotones">
                <button class="botones botonVolver" @onclick="VolverAlFormulario">
                    Buscar otra fecha
                </button>
            </div>
        }

    </div>

</div>

@code {

    private enum EstadoPantalla { Formulario, Listado }

    private EstadoPantalla estado = EstadoPantalla.Formulario;

    private int? dia;
    private int? mes;
    private int? anio;

    private string? mensajeError;
    private string? mensajeAccion;

    private List<mnts.Models.Gasto> gastosListado = new();
    private List<mnts.Models.Etiqueta> etiquetas = new();

    private int? editandoId;
    private string? categoriaEdicion;
    private string? montoEdicion;

    private int? eliminandoId;

    protected override async Task OnInitializedAsync()
    {
        etiquetas = await GastosService.ObtenerEtiquetasAsync();
    }

    private async Task BuscarGastos()
    {
        mensajeError = null;

        if (mes is null || mes < 1 || mes > 12)
        {
            mensajeError = "Error, ingrese un mes válido (1-12)";
            return;
        }

        if (anio is null || anio < 2000)
        {
            mensajeError = "Error, ingrese un año válido";
            return;
        }

        if (dia is not null && (dia < 1 || dia > 31))
        {
            mensajeError = "Error, ingrese un día válido (1-31)";
            return;
        }

        gastosListado = await GastosService.ObtenerGastosPorFechaAsync(dia, mes.Value, anio.Value);
        estado = EstadoPantalla.Listado;
    }

    private void IniciarEdicion(mnts.Models.Gasto gasto)
    {
        editandoId = gasto.Id;
        categoriaEdicion = gasto.Categoria;
        montoEdicion = gasto.Monto.ToString("0.##");
        eliminandoId = null;
    }

    private void CancelarEdicion()
    {
        editandoId = null;
        categoriaEdicion = null;
        montoEdicion = null;
    }

    private async Task GuardarEdicion(int id)
    {
        if (string.IsNullOrWhiteSpace(categoriaEdicion) ||
            string.IsNullOrWhiteSpace(montoEdicion) ||
            !double.TryParse(montoEdicion, out var monto))
        {
            mensajeAccion = "Error, revisá los datos ingresados";
            return;
        }

        await GastosService.ActualizarGastoAsync(id, categoriaEdicion, monto);

        editandoId = null;
        gastosListado = await GastosService.ObtenerGastosPorFechaAsync(dia, mes!.Value, anio!.Value);

        mensajeAccion = "Gasto actualizado correctamente";
        await MostrarMensajeTemporal();
    }

    private async Task ConfirmarEliminar(int id)
    {
        await GastosService.BorrarGastoPorIdAsync(id);

        eliminandoId = null;
        gastosListado = await GastosService.ObtenerGastosPorFechaAsync(dia, mes!.Value, anio!.Value);

        mensajeAccion = "Gasto eliminado correctamente";
        await MostrarMensajeTemporal();
    }

    private async Task MostrarMensajeTemporal()
    {
        StateHasChanged();
        await Task.Delay(1500);
        mensajeAccion = null;
        StateHasChanged();
    }

    private void VolverAlFormulario()
    {
        estado = EstadoPantalla.Formulario;
        gastosListado.Clear();
        dia = null;
        mes = null;
        anio = null;
        editandoId = null;
        eliminandoId = null;
        mensajeError = null;
        mensajeAccion = null;
    }

}