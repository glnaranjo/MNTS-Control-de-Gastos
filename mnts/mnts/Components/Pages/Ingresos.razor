@page "/Ingresos"
@inject mnts.Services.GastosService GastosService

<div class="ContenedorGastosMain">

    <NavLink href="/" class="BotonVolver">
        ← Volver
    </NavLink>

    <div class="ContenedorCentro">

        <div class="Header">
            <h2 class="Titulo">Añadir Ingresos</h2>
            <p class="Descripcion">Presupuesto mensual</p>
        </div>

        <div class="Seccion">
            <p class="subtitulo">Ingrese la fecha</p>
            <input type="date" class="InputFecha" @bind="fecha" />
        </div>

        <div class="Seccion">
            <p class="subtitulo">¿Qué cantidad desea añadir?</p>

            <div class="CantidadWrapper">
                <input type="text" placeholder="Ej: 50000" class="InputCantidad" @bind="cantidad" />
                <span class="SimboloMoneda">$</span>
            </div>
        </div>

        <div class="ContenedorBotones">
            <button class="botones Guardar" @onclick="GuardarIngreso">
                Enviar
            </button>
        </div>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="subtitulo2">@mensaje</p>
        }

    </div>

</div>

@code {

    private DateOnly? fecha;
    private string? cantidad;
    private string? mensaje;

    private async Task GuardarIngreso()
    {
        if (fecha is null)
        {
            mensaje = "Error, seleccione una fecha válida";
            await MostrarMensajeTemporal();
            return;
        }

        if (string.IsNullOrWhiteSpace(cantidad) || !double.TryParse(cantidad, out var monto))
        {
            mensaje = "Error, ingrese una cantidad válida";
            await MostrarMensajeTemporal();
            return;
        }

        await GastosService.InsertarIngresoAsync(fecha.Value.Month, fecha.Value.Year, monto);

        mensaje = "Presupuesto guardado correctamente";
        cantidad = null;

        await MostrarMensajeTemporal();
    }

    private async Task MostrarMensajeTemporal()
    {
        StateHasChanged();
        await Task.Delay(1500);
        mensaje = null;
        StateHasChanged();
    }

}